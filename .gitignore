# Ignore all local environment variables
.env

# Ignore all log files
*.log

# Ignore dependencies
node_modules/

# Ignore build output
dist/
client/dist/

# Ignore temp files
server/temp/

# Ignore macOS files
.DS_Store

# Ignore editor settings
.vscode/

# Ignore converted/downloaded media
server/*.mp4
server/*.webm
server/*.m4a

# Ignore generated conversion files without extensions
server/[0-9a-fA-F]*

# Ignore bundled binaries
server/bin/ffmpeg
server/bin/yt-dlp